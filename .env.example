# ChronosSched Environment Configuration Example
# Copy to .env for local development. NEVER commit .env or real secrets to version control.

# Optional Bearer token for Coordinator API authentication (--auth-token)
CHRONOS_AUTH_TOKEN=replace-with-strong-random-token

# Multi-tenant namespace identifier sent via X-Chronos-Tenant header
CHRONOS_TENANT=default

# Outbound webhook URL for terminal run notifications (--webhook-url)
CHRONOS_WEBHOOK_URL=https://example.com/webhooks/chronos

# HMAC-SHA256 signing secret for outbound webhook payloads (--webhook-secret)
CHRONOS_WEBHOOK_SECRET=replace-with-webhook-hmac-secret

# Structured log verbosity level (debug, info, warn, error)
CHRONOS_LOG_LEVEL=info
